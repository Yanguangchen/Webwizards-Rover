[Unit]
Description=Local Wi-Fi interface for the rover wheel controller
Wants=NetworkManager.service
Requires=sys-subsystem-net-devices-wlan0.device
After=NetworkManager.service sys-subsystem-net-devices-wlan0.device

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rover-controller-wifi
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
